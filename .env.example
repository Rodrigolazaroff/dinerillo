# Supabase: Settings -> API Keys del proyecto. Las dos son publicas por diseno
# (viajan al navegador); lo que protege los datos es RLS en la base.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para scripts/exportar-sheet.mjs, mientras dure la migracion desde la
# Google Sheet. Despues se borran.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
SHEET_ID=

# Secreta: la carga asistida por dictado y facturas (/api/ia).
ANTHROPIC_API_KEY=
