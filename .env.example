# Service Account de Google con acceso de editor a la Sheet.
GOOGLE_SA_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
# En una sola linea, con los saltos escapados como \n.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID de la planilla que oficia de base de datos.
SHEET_ID=

# Firma de la cookie de sesion. Cualquier string largo y random.
AUTH_SECRET=

# Clave para entrar a la app (rol editor).
AUTH_PASS_RODRIGO=

# Opcional: clave de solo lectura. Si no esta, ese usuario no existe.
# AUTH_PASS_INVITADO=

# Solo para el bootstrap, si crea la planilla desde cero: con quien compartirla.
SHARE_WITH=
